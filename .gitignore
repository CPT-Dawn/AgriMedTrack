# ==> EXPO
# Ignores the expo-cli specific cache and generated files.
.expo/
.expo-shared/
web-build/
updates/

# ==> DEPENDENCIES
# The node_modules folder is where all project dependencies are stored.
# It can be regenerated at any time by running `npm install` or `yarn install`.
node_modules/

# ==> ENVIRONMENT VARIABLES
# Ignore environment files, which may contain sensitive API keys.
# It's a best practice to commit a template file (e.g., .env.example).
.env
.env.*
!.env.example

# ==> SENSITIVE FILES
# Never commit signing keys, certificates, or provisioning profiles.
# These are highly sensitive and should be managed securely, not in version control.
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision

# ==> LOGS
# Ignore log files generated by package managers.
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==> IDE / EDITOR CONFIG
# Ignore editor-specific settings folders.
.vscode/
.idea/

# ==> MACOS
# Ignore macOS system files.
.DS_Store
.AppleDouble
.LSOverride

# ==> WINDOWS
# Ignore Windows system files.
Thumbs.db
ehthumbs.db
Desktop.ini